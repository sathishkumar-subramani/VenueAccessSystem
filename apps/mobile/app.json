{
  "expo": {
    "name": "Venue Access",
    "slug": "venue-access",
    "version": "1.0.0",
    "scheme": "venueaccess",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f6f5f1"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.venueaccess.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan visitor passes at the door."
      }
    },
    "android": {
      "package": "com.venueaccess.app",
      "adaptiveIcon": { "backgroundColor": "#f6f5f1" },
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Venue Access uses the camera to scan visitor passes." }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiUrl": "https://venue-access-api.onrender.com/api",
      "eas": { "projectId": "replace-with-your-eas-project-id" }
    }
  }
}
