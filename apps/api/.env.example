NODE_ENV=development
PORT=5080

# Must be a replica set — transactions are required by the ledger.
# Local:  docker compose up -d  &&  docker compose exec mongo mongosh --eval 'rs.initiate()'
MONGODB_URI=mongodb://localhost:27017/venue-access?replicaSet=rs0

# openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# openssl rand -base64 32
PASS_TOKEN_SECRET=replace-me-with-base64-of-32-random-bytes

# Venue types this instance serves. Remove one and it disappears from the app.
PLUGINS_ENABLED=gym,coworking,expo
PLUGIN_SETTINGS={}

CORS_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=

# Free tier: ~300 emails/day
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Venue Access

# Needs a DLT-approved template id for Indian numbers
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
